# Supabase (필수)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 마이그레이션 전용 Postgres 직접 연결 문자열 (Supabase 대시보드 > Project Settings > Database)
# npm run db:migrate 에서만 사용한다. 앱 런타임은 supabase-js 만 쓴다.
DATABASE_URL=

# OpenAI (필수)
OPENAI_API_KEY=
OPENAI_DEBATE_MODEL=gpt-4.1
OPENAI_TRIAGE_MODEL=gpt-4.1-mini
OPENAI_SCORING_MODEL=gpt-4.1

# 학생/교사 세션 쿠키 서명용 시크릿 (32바이트 이상 랜덤 문자열)
STUDENT_SESSION_SECRET=
TEACHER_SESSION_SECRET=
